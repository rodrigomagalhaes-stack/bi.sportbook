# ─────────────────────────────────────────────────────────────────────────────
# Copie para `.env` e preencha. No Vercel, as mesmas chaves entram em
# Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Portal: login único (Supabase Auth) + módulo Welcome Boost ───────────────
# Sem essas duas o portal abre SEM autenticação (e mostra o aviso "sem
# autenticação" no topo). É a chave pública/anon, a mesma que o navegador já
# enviava antes — não é a service_role, que nunca deve aparecer aqui.
VITE_SUPABASE_URL=https://lfuhmhubafgjqzuueyzw.supabase.co
VITE_SUPABASE_ANON_KEY=

# Dominios de e-mail liberados no cadastro, separados por virgula (vazio = sem
# restricao). A tela avisa na hora; quem bloqueia de verdade e o hook do
# Supabase — ver supabase/restringir_cadastro_por_dominio.sql.
VITE_DOMINIOS_PERMITIDOS=esportiva.bet

# ── Módulo Quiz (ex-Pick'em) ─────────────────────────────────────────────────
# Ficam separadas das VITE_SUPABASE_* porque as tabelas do Quiz
# (pickem_eventos / pickem_entradas) podiam estar em outro projeto Supabase —
# na prática estão no mesmo. Vazias = o Quiz abre em modo "Local", sem
# histórico nenhum, que foi o que aconteceu na primeira montagem do portal.
VITE_PICKEM_SUPABASE_URL=https://lfuhmhubafgjqzuueyzw.supabase.co
VITE_PICKEM_SUPABASE_ANON_KEY=

# ── Freebets · Processador (/api/freebets/eventos) ───────────────────────────
# Histórico de eventos já pagos, em Redis (Upstash/Vercel KV). Sem isso a tela
# funciona, mas responde "banco não configurado" ao marcar um evento como pago.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Monitor Super Odds (/api/monitor/*) ──────────────────────────────────────
# Postgres (Neon ou Supabase). Sem isso o monitor não funciona nem local nem no
# Vercel. Para o Vercel use a string com a porta 6543 (transaction pooler).
DATABASE_URL=

# Segredo do /api/monitor/cron. O Vercel injeta esse header sozinho no cron
# nativo; agendador externo precisa mandar `Authorization: Bearer <valor>`.
CRON_SECRET=

# Coleta — 15s vai direto na origem (CACHE_BUSTER contorna o cache de 45s da CDN)
POLL_SECONDS=15
CACHE_BUSTER=1
DISCOVER_MINUTES=10

# Catálogo (Altenar). A resposta por evento passa de 2 MB, por isso o cache.
EVENT_TTL_MINUTES=60
EVENT_IDLE_TTL_MINUTES=360
EVENTS_PER_TICK=20
ALTENAR_SPORT_IDS=66
SCAN=0

# Detecção
NEAR_LIMIT_PCT=0.9
STALL_MINUTES=20
STALL_MIN_COUNT=5

# Alertas (Slack, Discord ou endpoint próprio). Vazio = só registra no banco.
ALERT_WEBHOOK_URL=
ALERT_NEW_BOOST=0
ALERT_STALLED=1

# Telegram — avisa no celular quando uma trava esgota. Passo a passo em
# docs/monitor-superodds.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Retenção
HIDDEN_STALE_HOURS=3
RETENTION_DAYS=30

# Painel local do monitor (npm run monitor:serve)
PORT=8787
